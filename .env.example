NODE_ENV=development
PORT=3000

# Piper TTS Configuration
# Use 'piper' if installed in PATH (e.g. via pip install piper-tts) or specify absolute path to piper binary
PIPER_EXECUTABLE_PATH=piper
PIPER_MODEL_PATH=./models/tts/ta_IN-ValluvarNeural-medium.onnx

# MongoDB Atlas Connection
# Replace with your MongoDB Atlas cluster URI containing datasets DS1, DS2, DS3, DS4, DS7
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thiruvalluvar?retryWrites=true&w=majority"
